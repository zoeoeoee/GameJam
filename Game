<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Undead Pursuit</title>
<style>
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    background: #0d1410;
    font-family: 'Courier New', monospace;
    color: #d7e6c8;
  }
  h1 {
    letter-spacing: 3px;
    color: #8fbf5f;
    text-shadow: 0 0 8px rgba(143,191,95,0.5);
    margin: 0 0 6px;
    font-size: 28px;
  }
  #sub {
    color: #6b7a5e;
    margin-bottom: 14px;
    font-size: 13px;
  }
  #wrap {
    position: relative;
    border: 3px solid #3a4a2e;
    box-shadow: 0 0 30px rgba(0,0,0,0.6) inset, 0 0 20px rgba(60,90,40,0.3);
    background: linear-gradient(#1a2b1c, #0f1a10);
  }
  canvas { display: block; }
  #hud {
    position: absolute;
    top: 10px;
    left: 14px;
    right: 14px;
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    color: #d7e6c8;
    text-shadow: 0 0 4px #000;
    pointer-events: none;
  }
  #msg {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    text-align: center;
    color: #d7e6c8;
    display: none;
  }
  #msg h2 { color: #c94f4f; margin: 0 0 8px; text-shadow: 0 0 10px rgba(201,79,79,0.6); }
  #msg p { margin: 4px 0; font-size: 13px; color: #a8b898; }
  #btn {
    margin-top: 12px;
    padding: 8px 18px;
    background: #2b3a22;
    border: 1px solid #6b8a4a;
    color: #d7e6c8;
    font-family: inherit;
    cursor: pointer;
    font-size: 13px;
  }
  #btn:hover { background: #3a4d2e; }
  #controls {
    margin-top: 12px;
    font-size: 12px;
    color: #5c6b52;
  }
</style>
</head>
<body>
  <h1>UNDEAD PURSUIT</h1>
  <div id="sub">catch the human before your groans give out</div>
  <div id="wrap">
    <canvas id="game" width="700" height="320"></canvas>
    <div id="hud">
      <span id="distance">Distance: 0m</span>
      <span id="caught">Caught: 0</span>
    </div>
    <div id="msg">
      <h2 id="msgTitle">You collapsed</h2>
      <p id="msgSub">Distance: 0m — Humans caught: 0</p>
      <button id="btn">Rise again</button>
    </div>
  </div>
  <div id="controls">SPACE / UP = lunge over &nbsp;&nbsp; DOWN = crouch under &nbsp;&nbsp; click game to start</div>

<script>
const canvas = document.getElementById('game');
const ctx = canvas.getContext('2d');
const W = canvas.width, H = canvas.height;
const groundY = H - 50;

let state = 'ready'; // ready, running, over
let speed = 6;
let baseSpeed = 6;
let distance = 0;
let caught = 0;
let frame = 0;
let obstacles = [];
let nextObstacleAt = 0;
let human = { x: 480, y: groundY, vy: 0, ducking: false, w: 26, h: 44 };
let zombie = { x: 90, y: groundY, vy: 0, ducking: false, w: 28, h: 46, jumping: false };
const GRAVITY = 0.85;
const JUMP_V = -14.5;

function resetGame() {
  speed = baseSpeed;
  distance = 0;
  caught = 0;
  frame = 0;
  obstacles = [];
  nextObstacleAt = 60;
  human.x = 480; human.y = groundY; human.vy = 0; human.ducking = false;
  zombie.x = 90; zombie.y = groundY; zombie.vy = 0; zombie.ducking = false; zombie.jumping = false;
  document.getElementById('msg').style.display = 'none';
}

function spawnObstacle() {
  const type = Math.random() < 0.5 ? 'low' : 'high'; // low = jump over (grave), high = duck under (branch)
  obstacles.push({
    x: W + 20,
    type: type,
    w: type === 'low' ? 30 : 46,
    h: type === 'low' ? 34 : 20,
    passed: false
  });
}

function rectsOverlap(ax, ay, aw, ah, bx, by, bw, bh) {
  return ax < bx + bw && ax + aw > bx && ay < by + bh && ay + ah > by;
}

function update() {
  frame++;
  distance += speed / 10;
  speed = baseSpeed + Math.min(distance / 150, 9);

  // zombie physics
  if (zombie.jumping) {
    zombie.vy += GRAVITY;
    zombie.y += zombie.vy;
    if (zombie.y >= groundY) { zombie.y = groundY; zombie.jumping = false; zombie.vy = 0; }
  }

  // human AI: reacts to obstacles ahead of it, keeps some lead
  const humanBoxY = human.ducking ? human.y + 20 : human.y - 44;
  if (human.jumping) {
    human.vy += GRAVITY;
    human.y += human.vy;
    if (human.y >= groundY) { human.y = groundY; human.jumping = false; human.vy = 0; }
  }

  // spawn obstacles
  if (frame > nextObstacleAt) {
    spawnObstacle();
    nextObstacleAt = frame + 55 + Math.random() * 55;
  }

  // move obstacles, let human react, check collisions
  for (let i = obstacles.length - 1; i >= 0; i--) {
    const o = obstacles[i];
    o.x -= speed;

    // human reacts when obstacle is near its position
    const distToHuman = o.x - human.x;
    if (distToHuman > 0 && distToHuman < 90 && !o.humanHandled) {
      if (o.type === 'low' && !human.jumping) { human.jumping = true; human.vy = JUMP_V - 1; }
      if (o.type === 'high') { human.ducking = true; }
      o.humanHandled = true;
    }
    if (o.type === 'high' && distToHuman < -20 && human.ducking && distToHuman > -60) {
      human.ducking = true;
    } else if (o.type === 'high' && distToHuman <= -60) {
      human.ducking = false;
    }

    // zombie collision check
    const zTop = zombie.ducking ? zombie.y - 22 : zombie.y - 46;
    const zH = zombie.ducking ? 22 : 46;
    const zW = zombie.ducking ? 34 : 28;
    if (o.type === 'low') {
      // ground obstacle: must jump over. hits if zombie is on ground and not high enough
      if (rectsOverlap(zombie.x, zTop, zW, zH, o.x, groundY - o.h, o.w, o.h)) {
        if (zombie.y > groundY - o.h + 6) { gameOver(); return; }
      }
    } else {
      // overhead obstacle: must duck. hits if zombie is not ducking and in x range
      const obsY = groundY - 46;
      if (rectsOverlap(zombie.x, zTop, zW, zH, o.x, obsY, o.w, o.h)) {
        if (!zombie.ducking) { gameOver(); return; }
      }
    }

    if (o.x < -60) obstacles.splice(i, 1);
  }

  // zombie chases human: slowly close gap over time (pressure mechanic)
  const gap = human.x - zombie.x;
  if (gap < 140) {
    caught++;
    document.getElementById('caught').textContent = 'Caught: ' + caught;
    human.x += 220; // human bolts further ahead after being "caught"/spooked
    speed += 0.4;
  }
  if (gap > 420) {
    human.x -= 1.5; // don't let human run off too far
  }

  document.getElementById('distance').textContent = 'Distance: ' + Math.floor(distance) + 'm';
}

function gameOver() {
  state = 'over';
  document.getElementById('msgTitle').textContent = 'You collapsed';
  document.getElementById('msgSub').textContent = 'Distance: ' + Math.floor(distance) + 'm — Humans caught: ' + caught;
  document.getElementById('btn').textContent = 'Rise again';
  document.getElementById('msg').style.display = 'block';
}

function drawGround() {
  ctx.fillStyle = '#141f14';
  ctx.fillRect(0, groundY, W, H - groundY);
  ctx.strokeStyle = '#3a4a2e';
  ctx.lineWidth = 2;
  ctx.beginPath();
  ctx.moveTo(0, groundY);
  ctx.lineTo(W, groundY);
  ctx.stroke();
  // scrolling ground marks
  ctx.fillStyle = '#233623';
  const offset = (frame * speed) % 40;
  for (let x = -offset; x < W; x += 40) {
    ctx.fillRect(x, groundY + 10, 20, 3);
  }
  // moon
  ctx.fillStyle = '#cbd9b0';
  ctx.beginPath();
  ctx.arc(W - 60, 50, 22, 0, Math.PI * 2);
  ctx.fill();
}

function drawZombie() {
  const x = zombie.x, y = zombie.y;
  ctx.fillStyle = '#5c8a4a';
  if (zombie.ducking) {
    ctx.fillRect(x - 4, y - 24, 34, 22);
    ctx.fillStyle = '#3f6b32';
    ctx.fillRect(x + 20, y - 22, 12, 10); // head low
  } else {
    ctx.fillRect(x, y - 34, 22, 34); // torso
    ctx.fillStyle = '#3f6b32';
    ctx.fillRect(x + 2, y - 46, 18, 14); // head
    // arms reaching forward
    ctx.fillStyle = '#5c8a4a';
    const armSwing = zombie.jumping ? 6 : Math.sin(frame * 0.3) * 4;
    ctx.fillRect(x + 20, y - 30 + armSwing, 14, 6);
    // legs
    const legOffset = zombie.jumping ? 0 : Math.sin(frame * 0.4) * 6;
    ctx.fillRect(x + 2, y - 2, 7, 10 + legOffset * 0.2);
    ctx.fillRect(x + 12, y - 2, 7, 10 - legOffset * 0.2);
  }
  // eyes
  ctx.fillStyle = '#c94f4f';
  ctx.fillRect(x + (zombie.ducking ? 24 : 6), y - (zombie.ducking ? 18 : 40), 3, 3);
}

function drawHuman() {
  const x = human.x, y = human.y;
  ctx.fillStyle = '#e8c98f';
  if (human.ducking) {
    ctx.fillRect(x - 2, y - 22, 30, 20);
  } else {
    ctx.fillRect(x, y - 32, 20, 32);
    ctx.fillStyle = '#f0d8a8';
    ctx.fillRect(x + 2, y - 44, 16, 14);
    const legOffset = human.jumping ? 0 : Math.sin(frame * 0.5) * 7;
    ctx.fillStyle = '#e8c98f';
    ctx.fillRect(x, y - 2, 6, 10 + legOffset * 0.3);
    ctx.fillRect(x + 10, y - 2, 6, 10 - legOffset * 0.3);
  }
}

function drawObstacles() {
  for (const o of obstacles) {
    if (o.type === 'low') {
      ctx.fillStyle = '#8a8a7a';
      ctx.fillRect(o.x, groundY - o.h, o.w, o.h);
      ctx.strokeStyle = '#5c5c4e';
      ctx.strokeRect(o.x, groundY - o.h, o.w, o.h);
      ctx.fillStyle = '#5c5c4e';
      ctx.font = '10px monospace';
      ctx.fillText('RIP', o.x + 5, groundY - o.h + 20);
    } else {
      ctx.fillStyle = '#4a3a2a';
      ctx.fillRect(o.x, groundY - 46, o.w, o.h);
    }
  }
}

function draw() {
  ctx.clearRect(0, 0, W, H);
  drawGround();
  drawObstacles();
  drawHuman();
  drawZombie();
}

function loop() {
  if (state === 'running') {
    update();
  }
  draw();
  requestAnimationFrame(loop);
}

function jump() {
  if (state !== 'running') return;
  if (!zombie.jumping && !zombie.ducking) {
    zombie.jumping = true;
    zombie.vy = JUMP_V;
  }
}
function duck(on) {
  if (state !== 'running') return;
  if (!zombie.jumping) zombie.ducking = on;
}

function startGame() {
  resetGame();
  state = 'running';
}

document.addEventListener('keydown', (e) => {
  if (e.code === 'Space' || e.code === 'ArrowUp') {
    e.preventDefault();
    if (state !== 'running') { startGame(); return; }
    jump();
  }
  if (e.code === 'ArrowDown') {
    e.preventDefault();
    duck(true);
  }
});
document.addEventListener('keyup', (e) => {
  if (e.code === 'ArrowDown') duck(false);
});
canvas.addEventListener('click', () => {
  if (state !== 'running') startGame();
  else jump();
});
document.getElementById('btn').addEventListener('click', startGame);

resetGame();
draw();
requestAnimationFrame(loop);
</script>
</body>
</html>
